@model IEnumerable<ReleaseManager.Models.AppUser>
@{
    ViewData["Title"] = "Accounts";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="text-uppercase small fw-semibold text-primary mb-1">Administration</div>
        <h1 class="h2 mb-1">Accounts</h1>
        <div class="text-secondary">Create user accounts and manage access.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">＋ Register account</a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th class="ps-3">Username</th><th>Display name</th><th>Role</th><th>Status</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-3 fw-semibold">@user.Username</td>
                        <td>@user.DisplayName</td>
                        <td><span class="badge text-bg-light border">@user.Role</span></td>
                        <td><span class="badge rounded-pill @(user.Active ? "text-bg-success" : "text-bg-secondary")">@(user.Active ? "Active" : "Inactive")</span></td>
                        <td>@user.CreatedAt.ToString("M/d/yyyy")</td>
                        <td class="text-end pe-3"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">No accounts have been registered.</div>
        }
    </div>
</div>
