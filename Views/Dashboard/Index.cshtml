@model IEnumerable<Release>
@using ReleaseManager.Models
@{ViewData["Title"]="Dashboard";}<div class="d-flex justify-content-between align-items-center"><h2>Dashboard</h2><a class="btn btn-primary" href="/Releases/Create">+ New Release</a></div><div class="row mt-3"><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Recent releases</div><h2>@Model.Count()</h2></div></div></div></div><div class="card mt-4"><div class="card-body"><h5>Recent Releases</h5><table class="table"><thead><tr><th>Program</th><th>Version</th><th>Date</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a href="/Releases/Details/@x.Id">@x.ProgramInfo.Name</a></td><td>@x.Version</td><td>@(x.Status == ReleaseStatus.RELEASED ? x.ReleaseDate.ToString("dd/MM/yyyy") : "")</td><td><span class="badge bg-secondary">@x.Status</span></td></tr>}</tbody></table></div></div>
