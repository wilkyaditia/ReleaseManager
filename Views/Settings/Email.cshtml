@model EmailFormViewModel
@{
    ViewData["Title"] = "Email Configuration";
}
<h2>Email Configuration</h2>
<form method="post" action="/Settings/EmailSave">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label>Name</label><input asp-for="Name" class="form-control"></div>
    <div class="row">
        <div class="col-md-8 mb-3"><label>SMTP Host</label><input asp-for="SmtpHost" class="form-control"></div>
        <div class="col-md-4 mb-3"><label>Port</label><input asp-for="SmtpPort" class="form-control"></div>
    </div>
    <div class="mb-3"><label>Username</label><input asp-for="Username" class="form-control"></div>
    <div class="mb-3"><label>Password</label><input asp-for="Password" type="password" class="form-control"></div>
    <div class="mb-3"><label>From Address</label><input asp-for="FromAddress" class="form-control"></div>
    <div class="mb-3"><label>From Name</label><input asp-for="FromName" class="form-control"></div>
    <div class="mb-3"><label>Default To</label><input asp-for="DefaultTo" class="form-control"></div>
    <div class="mb-3"><label>Default CC</label><input asp-for="DefaultCc" class="form-control"></div>
    <div class="form-check"><input asp-for="UseSsl" class="form-check-input"><label asp-for="UseSsl"
                                                                                        class="form-check-label">Use SSL</label></div>
        <div class="form-check mb-3"><input asp-for="Active" class="form-check-input"><label asp-for="Active"
                                                                                                 class="form-check-label">Active</label></div><button class="btn btn-primary">Save</button>
        </form>