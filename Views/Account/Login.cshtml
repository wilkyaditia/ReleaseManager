@model LoginViewModel
@{Layout="_Layout";ViewData["Title"]="Login";}<div class="row justify-content-center"><div class="col-md-5"><div class="card shadow-sm"><div class="card-body"><h3>Release Manager</h3><p class="text-muted">Sign in</p><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autofocus></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"></div><button class="btn btn-primary w-100">Login</button></form><div class="small text-muted mt-3">Initial admin: admin / ChangeMe123! — change it after first login.</div></div></div></div></div>
